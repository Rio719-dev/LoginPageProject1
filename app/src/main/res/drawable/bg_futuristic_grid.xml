<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Main Deep Space Gradient -->
    <item>
        <shape>
            <gradient
                android:angle="135"
                android:centerColor="#0D1B2A"
                android:endColor="#050A18"
                android:startColor="#1B263B"
                android:type="linear" />
        </shape>
    </item>

    <!-- Subtle Radial Glow in Center -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:centerX="0.5"
                android:centerY="0.5"
                android:gradientRadius="400dp"
                android:startColor="#1A00F2FF"
                android:endColor="#00000000"
                android:type="radial" />
        </shape>
    </item>

    <!-- Vertical Circuit-like Lines (Subtle) -->
    <item android:left="40dp" android:right="350dp">
        <shape>
            <solid android:color="#0D00F2FF" />
            <size android:width="1dp" />
        </shape>
    </item>
</layer-list>