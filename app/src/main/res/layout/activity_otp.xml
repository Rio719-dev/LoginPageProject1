<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/alien_void_bg"
    android:padding="24dp">

    <com.google.android.material.card.MaterialCardView
        style="@style/AlienCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:strokeColor="@color/alien_glow_cyan"
        app:strokeWidth="1dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="32dp">

            <ImageView
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:layout_gravity="center"
                android:src="@android:drawable/stat_notify_chat"
                app:tint="@color/alien_glow_cyan" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginTop="16dp"
                android:fontFamily="serif-monospace"
                android:text="@string/otp_title"
                android:textColor="@color/alien_glow_cyan"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvOtpInstruction"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Enter the 6-digit synchronization code sent to your comms."
                android:textAlignment="center"
                android:textColor="@color/alien_star_white"
                android:textSize="14sp" />

            <com.google.android.material.textfield.TextInputLayout
                style="@style/AlienEditText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:hint="@string/hint_otp">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etOtpCode"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:inputType="number"
                    android:letterSpacing="0.5"
                    android:maxLength="6"
                    android:textColor="@color/alien_star_white"
                    android:textSize="24sp"
                    android:textStyle="bold" />
            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                android:id="@+id/tvOtpCountdown"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginTop="16dp"
                android:text="Resync available in: 00:30"
                android:textColor="@color/alien_warning_yellow"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnVerifyOtp"
                style="@style/AlienButton"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:layout_marginTop="32dp"
                android:text="@string/btn_verify_otp" />

            <Button
                android:id="@+id/btnResendOtp"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginTop="8dp"
                android:enabled="false"
                android:text="RETRANSMIT CODE"
                android:textColor="@color/alien_glow_purple" />

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

</androidx.constraintlayout.widget.ConstraintLayout>