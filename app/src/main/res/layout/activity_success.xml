<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:gravity="center" android:padding="24dp"
    android:fitsSystemWindows="true" android:background="?android:attr/colorBackground">
    <FrameLayout android:layout_width="88dp" android:layout_height="88dp">
        <View android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/bg_role_badge" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center"
            android:text="✓" android:textSize="40sp" android:textColor="@color/white" android:textStyle="bold" />
    </FrameLayout>
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="24dp"
        android:text="@string/success_title" android:textSize="24sp" android:textStyle="bold" android:textColor="?attr/colorOnSurface" />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp"
        android:gravity="center" android:text="@string/success_desc" android:textColor="?attr/colorOnSurfaceVariant" />
    <Button android:id="@+id/btnGoToLogin" android:layout_width="match_parent" android:layout_height="52dp"
        android:layout_marginTop="28dp" app:cornerRadius="14dp" android:text="@string/btn_login" android:textAllCaps="false" />
</LinearLayout>
